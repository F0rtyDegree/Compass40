#!/bin/bash

# Список всех файлов в нужном порядке
files=(
lib/controllers/home_state.dart
lib/controllers/home_logic.dart
)

# Вывести все файлы
for file in "${files[@]}"; do
    if [ -f "$file" ]; then
        echo "============= $file ==="
#        cat -n "$file"
        cat "$file"
        echo ""
    else
        echo "=== $file (ФАЙЛ НЕ НАЙДЕН) ==="
        echo ""
    fi
done