  final int id;
  final double latitude;
  final double longitude;
  double? distance;
  double? bearing;

  LogEntry({
    required this.id,
    required this.latitude,
    required this.longitude,
    this.distance,
    this.bearing,
    super.createdAt,
  }) : super(type: 'track');

  @override
