      final result = MapScreenLogic.computeResetRotation(
        mapRotation: 0,
        photoSeverNorthAngle: 0.0,
        photoSeverLinePixels: 100,
      );
      // Ожидаем: -π/2 - 0 = -π/2
      expect(result, closeTo(-math.pi / 2, 1e-9));
    });

    test('обычный режим A/F/N с mapRotation', () {
      final result = MapScreenLogic.computeResetRotation(
        mapRotation: 0.8,
