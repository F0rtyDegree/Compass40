#!/bin/bash
# Скрипт для сборки релиза APK
df -h .

# flutter clean 
# flutter pub get

flutter build apk --release
mv /home/user/myapp/build/app/outputs/flutter-apk/app-release.apk Compass40.apk

rm -rf /home/user/myapp/build/app/outputs/apk/debug/app-debug.apk
rm -rf /home/user/myapp/build/app/outputs/apk/release/app-release.apk
rm -rf /home/user/myapp/build/app/outputs/flutter-apk/app-debug.apk

# cd android && ./gradlew --stop
# rm -rf ~/.gradle/caches/
# cd ..

echo "--- сборка завершена: $(date) ---" >> sizes-log.txt
du -h --max-depth=1 /home/user/ | sort -rh >> sizes-log.txt
du -h --max-depth=1 /home/user/.gradle | sort -rh >> sizes-log.txt
du -h --max-depth=1 /home/user/.gradle/daemon | sort -rh >> sizes-log.txt
du -h --max-depth=1 /home/user/.gradle/caches | sort -rh >> sizes-log.txt
du -h --max-depth=1 /home/user/.gradle/caches/8.12 | sort -rh >> sizes-log.txt
df -h .  >> sizes-log.txt
df -h .
